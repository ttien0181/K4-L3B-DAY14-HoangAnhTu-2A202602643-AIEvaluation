# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then replace the placeholder value.
#
# Option A — OpenAI:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
#
# Option B — Gemini (recommended if OpenAI quota is exhausted):
OPENAI_API_KEY=your_gemini_api_key_here
OPENAI_MODEL=gemini-1.5-flash
